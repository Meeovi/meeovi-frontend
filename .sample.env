# ============================================
# .sample.env — not-yet-configured integrations
#
# Everything here is either empty or still a template placeholder value —
# none of it is wired up with a real credential yet, so none of it will
# actually do anything at launch. Split out of .env (2026-08-20) so the
# active file only contains vars that are genuinely live. Fill in a real
# value and move the line back to .env to activate an integration.
# ============================================

# ============================================
# Site Configuration
# ============================================
NUXT_PUBLIC_GITHUB_PAGE=

# ============================================
# Search Configuration
# Everything else in this block is real and active in .env — this one was
# left empty (only matters if the OpenSearch endpoint needs a custom CA).
# ============================================
ALTERNATE_SEARCH_CA_CERTS_PATH=

# ============================================
# Core Gateway & Routing
# ============================================
# Other endpoints in this app (AUTH_ENDPOINT, SEARCH_ENDPOINT) already
# point at https://meeovi.com/graphql — this one was left pointing at a
# local dev default and never updated.
MAPI_ENDPOINT=http://localhost:3000/api/graphql

# ============================================
# Database
# ============================================
# Prisma's own `prisma init` template default — NUXT_DATABASE_URL above is
# the real, active connection string this app actually uses.
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"

# ============================================
# Storage Configuration (MinIO)
# STORAGE_PROVIDER is set to "r2" in .env — these would only matter if you
# switch it to "minio". MINIO_ENDPOINT has a real host, but none of the
# actual credentials (access/secret key, bucket, region) are filled in.
# ============================================
MINIO_ENDPOINT=http://158.69.211.52
MINIO_PORT=9003
MINIO_USE_SSL=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_REGION=

# ============================================
# Image Optimization
# ============================================
CLOUDINARY_CLOUD_NAME="<Your Cloudinary Cloud Name>"

# ============================================
# Payment Configuration
# ============================================
# Stripe — real test keys are active in .env; only these price IDs were
# never filled in.
NUXT_STRIPE_PRICE_ID_PRO_MONTH=your-stripe-price-id-pro-month
NUXT_STRIPE_PRICE_ID_PRO_YEAR=your-stripe-price-id-pro-year

# PayPal — not configured at all (client ID is template text, secret empty)
NUXT_PUBLIC_SCRIPTS_PAYPAL_CLIENT_ID=AbcdEfghIjklMnopQrstuVwxYz
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true

# Polar — real sandbox access token/webhook secret are active in .env;
# only these product IDs were never filled in.
NUXT_POLAR_PRODUCT_ID_PRO_MONTH=your-polar-product-id-pro-month
NUXT_POLAR_PRODUCT_ID_PRO_YEAR=your-polar-product-id-pro-year

# ============================================
# Shipping Providers — none of these three are configured at all
# ============================================
UPS_API_KEY=
UPS_API_URL=
FEDEX_API_KEY=
FEDEX_API_URL=
DHL_API_KEY=
DHL_API_URL=

# ============================================
# Communication Providers
# ============================================
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token

NOVU_SECRET_KEY=your_secret_key
NUXT_PUBLIC_NOVU_APP_ID=xxx

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASS=your-password

# ============================================
# OAuth / Social Authentication
# ============================================
# Top-level GitHub OAuth app — distinct from BETTER_AUTH_GITHUB_CLIENT_ID/
# SECRET (which are real and active in .env); this pair was never filled in.
NUXT_GH_CLIENT_ID=your-github-client-id
NUXT_GH_CLIENT_SECRET=your-github-client-secret

# ============================================
# Site Analytics, Captcha, Monitoring, Ads, and Pixels
# ============================================
NUXT_PUBLIC_SCRIPTS_GOOGLE_ANALYTICS_ID=G-XXXXXXXX
NUXT_PUBLIC_SCRIPTS_GOOGLE_ADSENSE_CLIENT=ca-pub-1234567890123456
NUXT_PUBLIC_SCRIPTS_META_PIXEL_ID=123456789012345
NUXT_PUBLIC_SCRIPTS_REDDIT_PIXEL_ID=t2_abc123defg
NUXT_PUBLIC_SCRIPTS_SNAPCHAT_PIXEL_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NUXT_PUBLIC_SCRIPTS_TIKTOK_PIXEL_ID=CXXXXXXXXXXXXXX
NUXT_PUBLIC_SCRIPTS_X_PIXEL_ID=oxxxxxx
SENTRY_RELEASE=your_release_version_here

# ============================================
# GraphQL Federation / Apollo
# ============================================
# Also note: the literal `[@<VARIANT>]` in APOLLO_GRAPH_REF's placeholder
# breaks a plain `source .env` in bash (unmatched bracket) — harmless while
# it sits here unused, but don't copy that syntax verbatim into .env.
APOLLO_KEY=<YOU_APOLLO_API_KEY>
APOLLO_GRAPH_REF=<YOUR_GRAPH_ID>[@<VARIANT>]
HMAC_SECRET=your-hmac-secret

# ============================================
# Keycloak
# ============================================
# URL/REALM/CLIENT_ID/ISSUER are real and active in .env — only the client
# secret was never filled in, so the Keycloak OAuth flow can't complete
# without this.
KEYCLOAK_SECRET=your-keycloak-client-secret

# ============================================
# Mailchimp / Newsletter
# ============================================
MAILCHIMP_API_KEY=your-mailchimp-api-key
MAILCHIMP_SERVER_PREFIX=usX
MAILCHIMP_AUDIENCE_ID=your-audience-id
NEWSLETTER_PROVIDER=mailchimp
# BUTTONDOWN_API_KEY, MAILCHIMP_API_KEY, REVUE_API_KEY
NEWSLETTER_API_KEY=your-mailchimp-api-key

# ============================================
# Test Defaults — not production credentials, just fixtures the test
# suite uses (NUXT_TEST_* / NUXT_ADMIN_*). Not something launch depends on.
# ============================================
NUXT_TEST_APP_URL=http://localhost:3000
NUXT_TEST_EMAIL=test@nuxsaas.com
NUXT_TEST_PASSWORD=test-password
NUXT_ADMIN_EMAIL=admin@nuxsaas.com
NUXT_ADMIN_PASSWORD=admin-password
