# ============================================
# Site Configuration
# ============================================
NUXT_PUBLIC_SITE_URL=http://localhost:3002
NUXT_PUBLIC_SITE_NAME=Your App Name
NUXT_PUBLIC_SITE_DESCRIPTION=A one-line description of your site
NUXT_PUBLIC_SITE_EMAIL=support@example.com
NUXT_PUBLIC_SITE_AUTHOR=Your Company
NUXT_PUBLIC_TWITTER_HANDLE=@yourhandle
NUXT_PUBLIC_FACEBOOK_PAGE=https://www.facebook.com/yourpage
NUXT_PUBLIC_LINKEDIN_PAGE=https://www.linkedin.com/company/yourcompany
NUXT_PUBLIC_GITHUB_PAGE=
NUXT_SCRIPTS_PROXY_SECRET=generate-a-random-hex-string

# ============================================
# Application URLs & Metadata
# ============================================
NUXT_APP_URL=http://0.0.0.0:3011 # Base URL of your app
NUXT_APP_NAME=YourApp
# Read by layers/auth/server/utils/auth.ts and shared/utils/infrastructure/email.ts
# for the "from" address on every transactional email (password reset,
# verification, magic link, 2FA/email OTP). Must be a real verified sender
# on your Resend account or delivery will be rejected.
NUXT_APP_NOTIFY_EMAIL=noreply@example.com
NUXT_APP_CONTACT_EMAIL=info@example.com
NUXT_APP_REPO=https://github.com/yourorg/yourrepo
NUXT_PROJECT_ID=your-project-id
# Comma-separated list of origins better-auth will accept requests from
# (layers/auth/server/utils/auth.ts trustedOrigins) — include every
# domain/port your app is actually served from, or auth requests from it
# will be rejected.
NUXT_TRUSTED_ORIGINS=http://localhost:3002,http://localhost:8787
NUXT_NITRO_PRESET=node-server # node-server or cloudflare-module

# ============================================
# Core Gateway & Routing
# ============================================
MAPI_ENDPOINT=http://localhost:3000/api/graphql
AUTH_COOKIE_NAME=auth-token
AUTH_ENDPOINT=https://your-magento-instance.example.com/graphql
SEARCH_ENDPOINT=https://your-magento-instance.example.com/graphql
NUXT_PUBLIC_SEARCH_INDEX=default

# ============================================
# Adapter Selection
# ============================================
MEEOVI_PROVIDER=directus
NUXT_PUBLIC_AUTH_BACKEND=magento
# layers/commerce's backend-agnostic facade — 'directus' (default) or
# 'magento'. See layers/commerce/app/plugins/directus.ts.
NUXT_PUBLIC_COMMERCE_BACKEND=directus

# ============================================
# Auth Configuration (better-auth — layers/auth)
# ============================================
# Required in production — layers/auth/server/utils/auth.ts throws at
# startup if this is unset. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://0.0.0.0:3011
# Required by the dash() plugin (@better-auth/infra) — better-auth's own
# managed-infra product, used for its dashboard/observability features.
BETTER_AUTH_API_KEY=ba_your_dash_api_key

# ============================================
# Database Configuration
# ============================================
DATABASE_PROVIDER=postgresql
# Read by layers/auth/server/utils/drizzle.ts — this is the ONE variable
# that controls which Postgres instance better-auth's Drizzle adapter
# actually connects to. A pooled Supabase connection string is typical.
NUXT_DATABASE_URL=postgresql://postgres:your-password@your-project.supabase.co:5432/postgres

# Read by layers/social/server/utils/chat-store.ts's neighbors (activity
# feed fan-out, DMs) via ioredis. A plain redis:// URL, not http(s)://.
NUXT_REDIS_URL=redis://localhost:6379

# Optional: a separate development/staging database. Point
# NUXT_DATABASE_URL at this instead of production when testing schema
# changes — see layers/auth/drizzle.config.ts.
DEV_DATABASE_URL=postgresql://postgres:your-password@your-dev-host:5432/devdb

# ============================================
# Directus CMS
# ============================================
DIRECTUS_URL=https://your-directus-instance.example.com
DIRECTUS_GRAPHQL=https://your-directus-instance.example.com/graphql
# Read as NUXTUS_DIRECTUS_STATIC_TOKEN by layers/commerce, layers/search,
# layers/social's server-side Directus clients (getDirectusFacade() and
# every file that builds its own static-token client) — a Directus admin
# or service-account static access token.
NUXTUS_DIRECTUS_STATIC_TOKEN=your-directus-static-token
NUXTUS_DIRECTUS_AUTH=true
NUXTUS_DIRECTUS_ADMIN_EMAIL=admin@example.com
NUXTUS_DIRECTUS_ADMIN_PASSWORD=your-directus-admin-password
NUXT_PUBLIC_ENABLE_VISUAL_EDITING=true

# ============================================
# Search Configuration (layers/search)
# ============================================
# OpenSearch — enabled by default (it's the primary backend); set to
# 'false' to opt out and rely on the Postgres/MySQL/Magento providers only.
ALTERNATE_SEARCH_OPENSEARCH_ENABLED=true
ALTERNATE_SEARCH_PROTOCOL=https
ALTERNATE_SEARCH_HOST=localhost
ALTERNATE_SEARCH_PORT=9200
ALTERNATE_SEARCH_AUTH=admin:admin
ALTERNATE_SEARCH_CA_CERTS_PATH=

# Postgres/Supabase full-text search provider. Falls back to
# NUXT_DATABASE_URL/DATABASE_URL if unset, so it doesn't need duplicating
# in the common case where search runs against the app's own database.
ALTERNATE_SEARCH_PG_URL=
ALTERNATE_SEARCH_PG_SSL=require
# Certificate validation stays on by default even with SSL required —
# only set this for a genuinely self-signed/internal Postgres deployment.
ALTERNATE_SEARCH_PG_SSL_INSECURE=false
ALTERNATE_SEARCH_PG_TABLE=products
ALTERNATE_SEARCH_PG_ID_COLUMN=id
ALTERNATE_SEARCH_PG_COLUMNS=name,description

# MySQL search provider (optional third backend)
ALTERNATE_SEARCH_MYSQL_URL=

# InstantSearch multi-index switcher (searchBar.vue/resultsComponent.vue)
NUXT_PUBLIC_SEARCH_INDEXES=products

# ============================================
# Magento / eCommerce
# ============================================
MAGENTO_STORE_URL=https://your-magento-instance.example.com
MAGENTO_GRAPHQL_URL=https://your-magento-instance.example.com/graphql
# Storefront API token — confirmed live that this must NOT be sent as a
# customer JWT (customerToken); it's only used for search/catalog reads.
GQL_KEY=your-magento-storefront-api-token

# ============================================
# Storage Configuration
# ============================================
# Supported values: local, r2, s3, minio
STORAGE_PROVIDER=r2
NUXT_APP_STORAGE=r2
NUXT_LOCAL_UPLOAD_DIR=./uploads
NUXT_LOCAL_PUBLIC_PATH=/uploads
# MinIO — only needed if you actually stand up a MinIO instance; several
# older pages (layers/social's vibez.vue feed) assume it but it has no
# real, working integration in this codebase today without all of these
# set, including the access/secret keys.
MINIO_ENDPOINT=http://localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_REGION=

# ============================================
# Image Optimization Configuration
# ============================================
IMAGE_OPTIMIZER=netlify
IMAGE_PROVIDER=netlify
IMAGE_CDN_DOMAIN=
TWICPICS_DOMAIN=
NUXT_OG_IMAGE_SECRET=generate-a-random-hex-string
CLOUDINARY_CLOUD_NAME=

# ============================================
# Payment Configuration
# ============================================
PAYMENT_PROVIDER=stripe
NUXT_PAYMENT=stripe
NUXT_PUBLIC_CURRENCIES=USD,EUR,GBP

# Stripe — used by both layers/auth's stripe() plugin (customer creation,
# subscriptions, Connect onboarding — server/api/stripe/*.ts) and
# layers/commerce's own checkout/webhook flow.
NUXT_STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NUXT_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# Required for layers/auth's stripe() plugin's own webhook handling to
# verify signatures — must be the unprefixed-name mismatch is a real,
# previously-live bug this session found: the code reads this exact
# NUXT_-prefixed name, nothing else works.
NUXT_STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
NUXT_STRIPE_WEBHOOK_ENDPOINT_URL=https://yourapp.example.com/api/auth/stripe/webhook

# PayPal
NUXT_PUBLIC_SCRIPTS_PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_SANDBOX=true

# Polar (optional alternative billing provider)
NUXT_POLAR_SERVER=sandbox
NUXT_POLAR_ACCESS_TOKEN=
NUXT_POLAR_WEBHOOK_SECRET=

# ============================================
# Shipping Providers (layers/commerce)
# ============================================
SHIPPO_API_KEY=shippo_test_your_shippo_test_key
# Ship-from address — server/utils/shipping-origin.ts reads these split
# fields (NOT a single SHIPPO_ORIGIN_ADDRESS line). Must be a real,
# geocodable address for Shippo's rate/carrier validation to work at all.
SHIPPO_ORIGIN_NAME=Your Company Warehouse
SHIPPO_ORIGIN_COMPANY=Your Company
SHIPPO_ORIGIN_STREET1=123 Main St
SHIPPO_ORIGIN_STREET2=
SHIPPO_ORIGIN_CITY=San Francisco
SHIPPO_ORIGIN_STATE=CA
SHIPPO_ORIGIN_ZIP=94117
SHIPPO_ORIGIN_COUNTRY=US
SHIPPO_ORIGIN_PHONE=4155551234
SHIPPO_ORIGIN_EMAIL=shipping@example.com
# Self-defined shared secrets (not issued by Shippo) — generate your own.
# SHIPPING_ADMIN_TOKEN gates label/manifest/batch/refund endpoints (send
# as the x-shipping-admin-token header). SHIPPO_WEBHOOK_TOKEN verifies
# inbound Shippo tracking webhooks (?token= on the registered webhook URL).
SHIPPING_ADMIN_TOKEN=generate-a-random-hex-string
SHIPPO_WEBHOOK_TOKEN=generate-a-random-hex-string

# ============================================
# Communication Providers
# ============================================
# Real transactional email (layers/auth/shared/utils/infrastructure/email.ts)
# for password reset, verification, magic links, 2FA/email OTP. Without
# this set, all of the above silently no-op (a warning is logged, but no
# email is sent).
NUXT_RESEND_API_KEY=re_your_resend_api_key

# SMS/phone OTP (layers/auth's phoneNumber plugin) — without real values
# here, phone verification codes are only logged to the server console,
# never actually sent.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# ============================================
# OAuth / Social Authentication (layers/auth)
# ============================================
# Google and GitHub are wired directly into the core betterAuth() config
# (server/utils/auth.ts socialProviders) — set these two to enable "Sign
# in with Google/GitHub".
BETTER_AUTH_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
BETTER_AUTH_GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
BETTER_AUTH_GITHUB_CLIENT_ID=your-github-oauth-client-id
BETTER_AUTH_GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# The remaining 7 providers are wired through the genericOAuth plugin
# (shared/utils/plugins.ts) — verified against better-auth's own
# documented examples this session; setting real values here is the only
# remaining step to enable each one. Every var name below is read exactly
# as shown, no substitutions.
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_DOMAIN=your-tenant.us.auth0.com
GUMROAD_CLIENT_ID=
GUMROAD_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Real var read by the app is KEYCLOAK_SECRET (not KEYCLOAK_CLIENT_SECRET,
# which is what better-auth's own docs use as an example name — this repo
# just chose a shorter name; keep them matching if you rename either).
KEYCLOAK_CLIENT_ID=
KEYCLOAK_SECRET=
KEYCLOAK_ISSUER=https://your-keycloak-instance.example.com/realms/your-realm
# LINE requires a separate channel per country/market — see the
# providerId: 'line-jp' registration in shared/utils/plugins.ts if you
# need to add more (line-th, line-tw, etc, each with its own client id/
# secret pair following the same LINE_<COUNTRY>_CLIENT_ID pattern).
LINE_JP_CLIENT_ID=
LINE_JP_CLIENT_SECRET=
MS_APP_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_ISSUER=https://your-org.okta.com/oauth2/default
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=

# ============================================
# Site Analytics, Captcha, Monitoring, Ads, and Pixels
# ============================================
NUXT_PUBLIC_SCRIPTS_GOOGLE_TAG_MANAGER_ID=
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
NUXT_TURNSTILE_SECRET_KEY=
SENTRY_DSN=
NUXT_PUBLIC_SCRIPTS_GOOGLE_ANALYTICS_ID=
NUXT_PUBLIC_SCRIPTS_GOOGLE_ADSENSE_CLIENT=
NUXT_PUBLIC_SCRIPTS_META_PIXEL_ID=
NUXT_PUBLIC_SCRIPTS_REDDIT_PIXEL_ID=
NUXT_PUBLIC_SCRIPTS_SNAPCHAT_PIXEL_ID=
NUXT_PUBLIC_SCRIPTS_TIKTOK_PIXEL_ID=
NUXT_PUBLIC_SCRIPTS_X_PIXEL_ID=
NUXT_PUBLIC_SCRIPTS_BING_UET_ID=

# ============================================
# Recaptcha
# ============================================
NUXT_PUBLIC_SCRIPTS_GOOGLE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ============================================
# Comments (layers/social) — Waline
# ============================================
# Self-hosted Waline comment server URL. layers/social's comments.vue
# renders the real Waline widget against this — see
# components/blocks/comments.vue.
WALINE_SERVER_URL=https://your-waline-deployment.example.com

# ============================================
# Sentry
# ============================================
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_ORG=
SENTRY_PROJECT=

# ============================================
# Newsletter Configuration
# ============================================
NEWSLETTER_PROVIDER=mailchimp
NEWSLETTER_API_KEY= # or BUTTONDOWN_API_KEY / REVUE_API_KEY, matching NEWSLETTER_PROVIDER
MAILCHIMP_SERVER_PREFIX=usX
MAILCHIMP_AUDIENCE_ID=
