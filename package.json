{
  "name": "meeovi-frontend",
  "type": "module",
  "version": "0.0.5",
  "description": "Decentralized Social Shopping Networking, connecting people, products, and brands in a social commerce ecosystem.",
  "author": "The Meeovi Company",
  "homepage": "https://www.meeovi.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Meeovi/meeovi-frontend"
  },
  "bugs": {
    "url": "https://github.com/Meeovi/meeovi-frontend/issues"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "meeovi-commit": "git add . && git commit -m \"ready for update\"",
    "meeovi-update": "git pull \"https://github.com/Meeovi/meeovi-frontend\"",
    "dev": "nuxt dev --host 0.0.0.0 --port 3002",
    "dev-sw": "SW=true nuxi dev",
    "build": "nuxt build",
    "build-sw": "SW=true nuxi build",
    "smoke:auth": "bash ./scripts/auth-smoke.sh",
    "typecheck": "npx nuxi typecheck",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.11.2",
    "@sentry/nuxt": "^10",
    "nuxt": "^4.4.8",
    "pinia": "^3.0.3",
    "playwright-core": "^1.59.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "nuxt-layers-utils": "^0.3.1"
  },
  "overrides": {
    "vue": "latest"
  }
}
